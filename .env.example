# ============================================
# LOAD BALANCER CONFIGURATION
# ============================================

# Load Balancer Port
LB_PORT=8084

# ============================================
# DATABASE - MySQL
# ============================================

MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=app123
MYSQL_PORT=3306
MYSQL_HOST=mysql-app

# ============================================
# DATABASE - PostgreSQL (Events)
# ============================================

POSTGRES_EVENTS_DB=eventstore
POSTGRES_EVENTS_USER=events
POSTGRES_EVENTS_PASSWORD=events123
POSTGRES_EVENTS_PORT=5433
POSTGRES_EVENTS_HOST=postgres-events

# ============================================
# DATABASE - MongoDB
# ============================================

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=querydb
MONGO_PORT=27017
MONGO_HOST=mongodb-query

# ============================================
# MESSAGE BROKER - RabbitMQ
# ============================================

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=rabbitmq

# ============================================
# APPLICATION SETTINGS
# ============================================

LOG_LEVEL=info
ENVIRONMENT=development
DEBUG=false

# ============================================
# LOAD BALANCER SETTINGS
# ============================================

# Health check interval (milliseconds)
HEALTH_CHECK_INTERVAL=3000

# Proxy timeouts (seconds)
PROXY_CONNECT_TIMEOUT=60
PROXY_SEND_TIMEOUT=60
PROXY_READ_TIMEOUT=60

# Client max body size (MB)
CLIENT_MAX_BODY_SIZE=50

# ============================================
# BACKEND SERVICES
# ============================================

# NestJS API
NESTJS_API_PORT=3000
NESTJS_API_HOST=nestjs-app

# .NET API
DOTNET_API_PORT=3002
DOTNET_API_HOST=dotnet-app

# Connection string examples (customize as needed)
# DATABASE_URL=mysql://appuser:app123@mysql-app:3306/appdb
# EVENTS_DATABASE_URL=postgresql://events:events123@postgres-events:5433/eventstore
# MONGODB_URL=mongodb://admin:admin123@mongodb-query:27017/querydb
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
